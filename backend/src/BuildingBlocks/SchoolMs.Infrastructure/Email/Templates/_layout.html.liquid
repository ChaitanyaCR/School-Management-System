<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ product_name }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f5;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;color:#18181b;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f5;padding:24px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:8px;padding:32px;">
          <tr>
            <td style="font-size:15px;line-height:1.6;">
              {{ content | raw }}
            </td>
          </tr>
        </table>
        <p style="max-width:560px;font-size:12px;color:#71717a;margin:16px 0 0;">
          Sent by {{ product_name }}. If you did not expect this email, you can ignore it.
        </p>
      </td>
    </tr>
  </table>
</body>
</html>
