{
  "openapi": "3.1.1",
  "info": {
    "title": "School Management System API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/system/info": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Product name, version and environment.",
        "operationId": "GetSystemInfo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tenancy/current": {
      "get": {
        "tags": [
          "tenancy"
        ],
        "summary": "The organisation for the current subdomain.",
        "operationId": "GetCurrentOrganisation",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentOrganisationResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CurrentOrganisationResponse": {
        "required": [
          "slug",
          "name"
        ],
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "description": "The organisation served at this address; shown before login (e.g. on the sign-in page)."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SystemInfoResponse": {
        "required": [
          "productName",
          "version",
          "environment"
        ],
        "type": "object",
        "properties": {
          "productName": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          }
        },
        "description": "Public, non-sensitive information the UI needs before login (branding, version)."
      }
    }
  },
  "tags": [
    {
      "name": "system"
    },
    {
      "name": "tenancy"
    }
  ]
}